# Only needed when running the studio on your own computer.
# On GitHub, the same names go in Settings → Secrets and variables → Actions.

# AI brain: set ONE of these. Gemini has a free tier; Claude is paid and best quality.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PEXELS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

CHANNEL_NAME=Uzorka Tech
TARGET_MINUTES=8
PUBLISH_MODE=manual
# PUBLISH_PRIVACY=public
# DISCLOSE_SYNTHETIC=true
# ELEVENLABS_MODEL=eleven_multilingual_v2
# AI_PROVIDER=gemini            # or anthropic (auto: Claude if its key is set)
# GEMINI_MODEL=gemini-flash-latest
# DESCRIPTION_FOOTER=Voice generated with ElevenLabs (elevenlabs.io)
# CLAUDE_MODEL=claude-opus-5-5
# BROWSER_EXECUTABLE=/path/to/chrome
